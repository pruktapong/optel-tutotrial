apiVersion: v1
kind: ConfigMap
metadata:
  name: k6-script
  namespace: java-test
data:
  load.js: |
    import http from 'k6/http';
    import { sleep } from 'k6';

    export const options = {
      vus: 20,          // 20 concurrent users
      duration: '2m',   // run for 2 minutes
    };

    export default function () {
      http.get('http://my-java-service.java-test.svc.cluster.local:8080/');
      sleep(0.1);
    }

---
apiVersion: batch/v1
kind: Job
metadata:
  name: k6-loadtest
  namespace: java-test
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: k6
        image: grafana/k6:latest
        command: ["k6", "run", "/scripts/load.js"]
        volumeMounts:
        - name: script
          mountPath: /scripts
      volumes:
      - name: script
        configMap:
          name: k6-script
          items:
          - key: load.js
            path: load.js
